// Iterative approach
// TC => O(n), SC=> O(n)

function reverseIterative(s) {
  let arr = s.split("");
  let start = 0,
    end = arr.length - 1;

  while (start < end) {
    [arr[start], arr[end]] = [arr[end], arr[start]];
    start++;
    end--;
  }

  return arr.join("");
}

console.log(reverseIterative("aditya"));

// Recursive Approach
// TC => O(n), SC => O(n)

function reverseRecursive(s) {
  if (s.length <= 1) return s;

  return reverseRecursive(s.slice(1)) + s[0];
}

console.log(reverseRecursive("aditya"));
